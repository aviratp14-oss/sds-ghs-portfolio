		lineageTag: 54878f82-2cdf-5f74-83f6-14beb769e3f6

	measure 'Gas Sold bcm' = SUM(Fact_SubpartW_Facility_Production[Gas_Sales_bcm])
		formatString: #,##0.0
		displayFolder: 2. Oil & gas intensity
		lineageTag: fb29bfd0-5f38-5269-8690-d995532c48bf

	measure 'Methane Produced t' =
			-- methane in the gas sold: bcm x 678,000 t per bcm (0.678 kg/m3) x methane share of the gas (0.85 when not reported)
			SUMX(
			    Fact_SubpartW_Facility_Production,
			    Fact_SubpartW_Facility_Production[Gas_Sales_bcm] * 678000
			        * IF(Fact_SubpartW_Facility_Production[CH4_Mole_Fraction_Avg] > 0, Fact_SubpartW_Facility_Production[CH4_Mole_Fraction_Avg], 0.85)
			)
		formatString: #,##0
		displayFolder: 2. Oil & gas intensity
		lineageTag: 21627126-2143-5494-81f5-fd91daaa6fb2

	measure 'Methane Intensity %' = DIVIDE([Production Methane t], [Methane Produced t])
		formatString: 0.00%
		displayFolder: 2. Oil & gas intensity
		lineageTag: f36cea66-2af2-55bc-956f-b0bae584ab7b

	measure 'Producing Wells' = SUM(Fact_SubpartW_Facility_Production[Wells_Producing])
