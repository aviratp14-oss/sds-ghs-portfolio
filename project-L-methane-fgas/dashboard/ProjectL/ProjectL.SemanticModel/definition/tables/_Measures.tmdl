		lineageTag: 3bbfd354-4582-52a1-944d-ca5a377f87f1

	measure 'US Methane Rank' =
			RANKX(
			    FILTER(ALL(Fact_IEA_Methane[Country]), CALCULATE([IEA Methane Mt]) > 0),
			    CALCULATE([IEA Methane Mt]),
			    CALCULATE([IEA Methane Mt], Fact_IEA_Methane[Country] = "United States"),
			    DESC
			)
		formatString: 0
		displayFolder: 5. Global benchmark
		lineageTag: 3379070a-43ad-579c-85cb-10863e440758

	measure 'IEA Methane Mt (Top 15)' =
			VAR r = RANKX(FILTER(ALL(Fact_IEA_Methane[Country]), CALCULATE([IEA Methane Mt]) > 0), CALCULATE([IEA Methane Mt]), , DESC)
			RETURN IF(HASONEVALUE(Fact_IEA_Methane[Country]) && r <= 15, [IEA Methane Mt])
		formatString: #,##0.0
		displayFolder: 5. Global benchmark
		lineageTag: 988b9116-490e-5d22-bbdb-342c0668a59f

	measure 'Color Country Bar' = IF(SELECTEDVALUE(Fact_IEA_Methane[Country]) = "United States", "#2F6B4F", "#B9D1C2")
		formatString: General
		displayFolder: 6. Report visuals
		lineageTag: 22fc9661-8063-54f4-9ff8-9ec7607c44e1

	measure 'Color Latest Trade Year' = IF(SELECTEDVALUE(Dim_Year[Year]) = CALCULATE(MAX(Fact_Trade_EU_Imports[Year]), REMOVEFILTERS()), "#2F6B4F", "#B9D1C2")
		formatString: General
		displayFolder: 6. Report visuals
		lineageTag: 5d1b0784-6111-5436-8bdb-19536bb25f59

	measure 'Color Cost Sign' = IF([Avg Cost USD per tCO2e] < 0, "#2F6B4F", "#C9826B")
		formatString: General
		displayFolder: 6. Report visuals
		lineageTag: 8c6d2162-2432-5976-b896-fe3dc12cd0eb

	measure 'Header Overview' =
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1280' height='78' viewBox='0 0 1280 78' preserveAspectRatio='none'>"
			    & "<rect width='1280' height='78' fill='%231F3B2D'/>"
			    & "<text x='28' y='38' font-family='Georgia, serif' font-size='24' font-weight='bold' fill='%23FFFFFF'>US greenhouse gas emissions</text>"
			    & "<text x='28' y='62' font-family='Segoe UI, sans-serif' font-size='13' fill='%23FFFFFF'>Facility emissions reported to the EPA (GHGRP), in AR5 CO2e. Year filter drives the cards and the segment chart.</text>"
			    & "</svg>"
		formatString: General
		displayFolder: 6. Report visuals
		lineageTag: f0d21fb2-acd3-5f13-9733-79ac05703c32
		dataCategory: ImageUrl

	measure 'Card GHG' =
			VAR y = [Selected Year]
			VAR cur = CALCULATE([GHG MtCO2e], REMOVEFILTERS(Dim_Year), Dim_Year[Year] = y)
			VAR prev = CALCULATE([GHG MtCO2e], REMOVEFILTERS(Dim_Year), Dim_Year[Year] = y - 1)
			VAR chg = DIVIDE(cur - prev, prev)
			VAR dTxt = IF(ISBLANK(prev) || ISBLANK(cur), "", IF(chg >= 0, "▲ +", "▼ -") & FORMAT(ABS(chg), "0%") & " vs " & (y - 1))
			VAR dCol = IF(chg <= 0, "%232F6B4F", "%23B3462E")
			VAR vTxt = IF(ISBLANK(cur), "–", FORMAT(cur, "#,##0"))
			VAR vOut = SUBSTITUTE(SUBSTITUTE(vTxt, "%", "%25"), "#", "%23")
			VAR dOut = SUBSTITUTE(SUBSTITUTE(dTxt, "%", "%25"), "#", "%23")
			VAR pts = FILTER(ADDCOLUMNS(FILTER(ALL(Dim_Year[Year]), Dim_Year[Year] >= 2011 && Dim_Year[Year] <= 2023), "@v", [GHG MtCO2e]), NOT ISBLANK([@v]))
			VAR mx = MAXX(pts, [@v])
			VAR mn = MIN(0, MINX(pts, [@v]))
			VAR poly = CONCATENATEX(pts, FORMAT(ROUND(176 + 104 * (Dim_Year[Year] - 2011) / 12, 0), "0") & "," & FORMAT(ROUND(78 - 34 * DIVIDE([@v] - mn, mx - mn), 0), "0"), " ", Dim_Year[Year], ASC)
			VAR lastYr = MAXX(pts, Dim_Year[Year])
			VAR lastV = MAXX(FILTER(pts, Dim_Year[Year] = lastYr), [@v])
			VAR dot = "<circle cx='" & FORMAT(ROUND(176 + 104 * (lastYr - 2011) / 12, 0), "0") & "' cy='" & FORMAT(ROUND(78 - 34 * DIVIDE(lastV - mn, mx - mn), 0), "0") & "' r='3' fill='%232F6B4F'/>"
			VAR sp = IF(COUNTROWS(pts) > 1, "<polyline points='" & poly & "' fill='none' stroke='%232F6B4F' stroke-width='2' stroke-linejoin='round'/>" & dot)
			RETURN
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='296' height='118' viewBox='0 0 296 118'>"
			    & "<rect x='0.5' y='0.5' width='295' height='117' rx='10' fill='%23FFFDF8' stroke='%23E6DFD1'/>"
			    & "<text x='16' y='27' font-family='Segoe UI, sans-serif' font-size='12' fill='%2326241F'>Total GHG emissions</text>"
			    & "<text x='16' y='72' font-family='Segoe UI Semibold, Segoe UI, sans-serif' font-size='30' font-weight='600' fill='%231D1C1A'>" & vOut & "<tspan font-size='14' font-weight='normal' fill='%2326241F'> Mt CO2e</tspan></text>"
			    & "<text x='16' y='100' font-family='Segoe UI, sans-serif' font-size='12' fill='" & dCol & "'>" & dOut & "</text>"
			    & sp & "</svg>"
		formatString: General
		displayFolder: 6. Report visuals
		lineageTag: 81fec6b4-ba99-541d-9c60-8ca8824be005
		dataCategory: ImageUrl

	measure 'Card Methane' =
			VAR y = [Selected Year]
			VAR cur = CALCULATE([Methane MtCO2e], REMOVEFILTERS(Dim_Year), Dim_Year[Year] = y)
			VAR prev = CALCULATE([Methane MtCO2e], REMOVEFILTERS(Dim_Year), Dim_Year[Year] = y - 1)
			VAR chg = DIVIDE(cur - prev, prev)
			VAR dTxt = IF(ISBLANK(prev) || ISBLANK(cur), "", IF(chg >= 0, "▲ +", "▼ -") & FORMAT(ABS(chg), "0%") & " vs " & (y - 1))
			VAR dCol = IF(chg <= 0, "%232F6B4F", "%23B3462E")
			VAR vTxt = IF(ISBLANK(cur), "–", FORMAT(cur, "#,##0"))
			VAR vOut = SUBSTITUTE(SUBSTITUTE(vTxt, "%", "%25"), "#", "%23")
			VAR dOut = SUBSTITUTE(SUBSTITUTE(dTxt, "%", "%25"), "#", "%23")
			VAR pts = FILTER(ADDCOLUMNS(FILTER(ALL(Dim_Year[Year]), Dim_Year[Year] >= 2011 && Dim_Year[Year] <= 2023), "@v", [Methane MtCO2e]), NOT ISBLANK([@v]))
			VAR mx = MAXX(pts, [@v])
			VAR mn = MIN(0, MINX(pts, [@v]))
