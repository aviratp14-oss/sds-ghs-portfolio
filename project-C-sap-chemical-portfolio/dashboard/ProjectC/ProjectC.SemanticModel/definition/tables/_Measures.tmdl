			    & "<rect x='0.5' y='0.5' width='253' height='109' rx='4' fill='%23FFFFFF' stroke='%23E5E5E5'/>"
			    & "<text x='16' y='26' font-family=""'72', Segoe UI, Arial, sans-serif"" font-size='14' fill='%2332363A'>At risk</text>"
			    & "<text x='16' y='44' font-family=""'72', Segoe UI, Arial, sans-serif"" font-size='11' fill='%236A6D70'>" & sOut & "</text>"
			    & "<text x='16' y='90' font-family=""'72', Segoe UI, Arial, sans-serif"" font-size='32' font-weight='300' fill='" & clr & "'>" & vOut & "<tspan font-size='14' fill='%236A6D70'> " & uOut & "</tspan></text>"
			    & "</svg>"
		formatString: General
		displayFolder: 5. Report visuals
		lineageTag: 4f85b530-95de-592a-aa1c-3d9fbdfda969
		dataCategory: ImageUrl

	measure 'Card Lapsed12' =
			VAR cur = [Lapsed Last 12m]
			VAR sub = FORMAT([Lapsed Customers], "0") & " lapsed since 2022"
			VAR clr = "%23BB0000"
			VAR unit = ""
			VAR vTxt = IF(ISBLANK(cur), "–", FORMAT(cur, "#,##0"))
			VAR vOut = SUBSTITUTE(SUBSTITUTE(vTxt, "%", "%25"), "#", "%23")
			VAR sOut = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(sub, "&", "&amp;"), "%", "%25"), "#", "%23")
			VAR uOut = SUBSTITUTE(SUBSTITUTE(unit, "%", "%25"), "#", "%23")
			RETURN
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='254' height='110' viewBox='0 0 254 110'>"
			    & "<rect x='0.5' y='0.5' width='253' height='109' rx='4' fill='%23FFFFFF' stroke='%23E5E5E5'/>"
			    & "<text x='16' y='26' font-family=""'72', Segoe UI, Arial, sans-serif"" font-size='14' fill='%2332363A'>Lapsed in the last 12 months</text>"
			    & "<text x='16' y='44' font-family=""'72', Segoe UI, Arial, sans-serif"" font-size='11' fill='%236A6D70'>" & sOut & "</text>"
			    & "<text x='16' y='90' font-family=""'72', Segoe UI, Arial, sans-serif"" font-size='32' font-weight='300' fill='" & clr & "'>" & vOut & "<tspan font-size='14' fill='%236A6D70'> " & uOut & "</tspan></text>"
			    & "</svg>"
		formatString: General
		displayFolder: 5. Report visuals
		lineageTag: 7756604b-74fd-59dc-a173-6f701f75767e
		dataCategory: ImageUrl

	measure 'Card Lost' =
			VAR cur = [Recent Lost Revenue M]
			VAR sub = "Annual revenue of those " & FORMAT([Lapsed Last 12m], "0") & " customers"
			VAR clr = "%23BB0000"
			VAR unit = "M/yr"
			VAR vTxt = IF(ISBLANK(cur), "–", FORMAT(cur, "$#,##0.0"))
			VAR vOut = SUBSTITUTE(SUBSTITUTE(vTxt, "%", "%25"), "#", "%23")
			VAR sOut = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(sub, "&", "&amp;"), "%", "%25"), "#", "%23")
			VAR uOut = SUBSTITUTE(SUBSTITUTE(unit, "%", "%25"), "#", "%23")
			RETURN
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='254' height='110' viewBox='0 0 254 110'>"
			    & "<rect x='0.5' y='0.5' width='253' height='109' rx='4' fill='%23FFFFFF' stroke='%23E5E5E5'/>"
			    & "<text x='16' y='26' font-family=""'72', Segoe UI, Arial, sans-serif"" font-size='14' fill='%2332363A'>Revenue lost to recent lapses</text>"
			    & "<text x='16' y='44' font-family=""'72', Segoe UI, Arial, sans-serif"" font-size='11' fill='%236A6D70'>" & sOut & "</text>"
			    & "<text x='16' y='90' font-family=""'72', Segoe UI, Arial, sans-serif"" font-size='32' font-weight='300' fill='" & clr & "'>" & vOut & "<tspan font-size='14' fill='%236A6D70'> " & uOut & "</tspan></text>"
			    & "</svg>"
		formatString: General
		displayFolder: 5. Report visuals
		lineageTag: 0413c892-5b83-5217-b90e-5bc0e8ec2c10
		dataCategory: ImageUrl

	measure 'Color Discount' = IF([DINP Avg Discount %] > 0.06, "#BB0000", "#91C8F6")
		formatString: General
		displayFolder: 5. Report visuals
		lineageTag: 423237f4-d749-50f6-adc9-43f30ab0e712

	measure 'Color Pair' = IF(LEFT(SELECTEDVALUE(Map_Make_vs_Buy[Pair_Label]), 4) = "2-EH", "#BB0000", "#E9B3B3")
		formatString: General
		displayFolder: 5. Report visuals
		lineageTag: d66fb777-2ed0-5baa-b223-0a7ac9fdb371

	measure 'Color Profile' =
			SWITCH(SELECTEDVALUE(Fact_Customer_Health[Plasticizer_Profile]),
			    "Switched A to B", "#BB0000",
			    "Loyal to A", "#0A6ED1",
			    "#B8C3CC")
		formatString: General
		displayFolder: 5. Report visuals
		lineageTag: 9dfdbb73-b0e7-5c5e-8c41-75ad836d268a

