	measure 'Forecast 90% Low Mt' = CALCULATE(SUM(Fact_Forecast_Methane[Lower_90_MtCO2e]), Fact_Forecast_Methane[Series] = "Forecast", Fact_Forecast_Methane[Segment] = "All Segments")
		formatString: #,##0.0
		displayFolder: 7. Forecast
		lineageTag: 73a14574-6c4c-5341-a082-7db65da13d41

	measure 'Forecast 90% High Mt' = CALCULATE(SUM(Fact_Forecast_Methane[Upper_90_MtCO2e]), Fact_Forecast_Methane[Series] = "Forecast", Fact_Forecast_Methane[Segment] = "All Segments")
		formatString: #,##0.0
		displayFolder: 7. Forecast
		lineageTag: 3075605d-42ee-5297-bd0c-4d29be164d88

	measure 'Pledge Path Mt' = CALCULATE(SUM(Fact_Forecast_Methane[Methane_MtCO2e]), Fact_Forecast_Methane[Series] = "Pledge")
		formatString: #,##0.0
		displayFolder: 7. Forecast
		lineageTag: 50bf20d0-fbec-55f1-9366-506d84367228

	measure 'Last Actual Year' = CALCULATE(MAX(Fact_Forecast_Methane[Year]), REMOVEFILTERS(), Fact_Forecast_Methane[Series] = "Actual")
		formatString: 0
		displayFolder: 7. Forecast
		lineageTag: 9f8bac35-e7fb-5163-b215-6acd2aa23e70

	measure 'Forecast Year' =
			VAR s = SELECTEDVALUE(Dim_Year[Year])
			VAR last = CALCULATE(MAX(Fact_Forecast_Methane[Year]), REMOVEFILTERS())
			RETURN IF(s > [Last Actual Year] && s <= last, s, last)
		formatString: 0
		displayFolder: 7. Forecast
		lineageTag: b3b9fe24-d9dd-5322-bcf5-80372a3546f6

	measure 'Forecast Gap to Pledge Mt' = IF(NOT ISBLANK([Methane Forecast Mt]) && NOT ISBLANK([Pledge Path Mt]), [Methane Forecast Mt] - [Pledge Path Mt])
		formatString: +#,##0.0;-#,##0.0;0.0
		displayFolder: 7. Forecast
		lineageTag: 30d85888-1544-5104-8858-c2e865fdb6c1

	measure 'Forecast Trend Mt per yr' =
			VAR last = CALCULATE(MAX(Fact_Forecast_Methane[Year]), REMOVEFILTERS())
			RETURN CALCULATE([Methane Forecast Mt], REMOVEFILTERS(Dim_Year), Dim_Year[Year] = last) - CALCULATE([Methane Forecast Mt], REMOVEFILTERS(Dim_Year), Dim_Year[Year] = last - 1)
		formatString: #,##0.0
		displayFolder: 7. Forecast
		lineageTag: d1fa2585-05a7-5965-a6a3-a69f06ad6f1b

	measure 'Forecast Change by Segment Mt' =
			VAR y = [Forecast Year]
			VAR la = [Last Actual Year]
			VAR f = CALCULATE(SUM(Fact_Forecast_Methane[Methane_MtCO2e]), REMOVEFILTERS(Dim_Year), Fact_Forecast_Methane[Year] = y, Fact_Forecast_Methane[Series] = "Forecast")
			VAR a = CALCULATE(SUM(Fact_Forecast_Methane[Methane_MtCO2e]), REMOVEFILTERS(Dim_Year), Fact_Forecast_Methane[Year] = la, Fact_Forecast_Methane[Series] = "Actual")
			RETURN IF(HASONEVALUE(Fact_Forecast_Methane[Segment]) && SELECTEDVALUE(Fact_Forecast_Methane[Segment]) <> "All Segments", f - a)
		formatString: +#,##0.0;-#,##0.0;0.0
		displayFolder: 7. Forecast
		lineageTag: ef688d24-085a-59f7-9c36-15c21ca7b75c

	measure 'Header Forecast' =
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1280' height='78' viewBox='0 0 1280 78' preserveAspectRatio='none'>"
			    & "<rect width='1280' height='78' fill='%231F3B2D'/>"
			    & "<text x='28' y='38' font-family='Georgia, serif' font-size='24' font-weight='bold' fill='%23FFFFFF'>US methane outlook to 2030</text>"
			    & "<text x='28' y='62' font-family='Segoe UI, sans-serif' font-size='13' fill='%23FFFFFF'>Linear trend fitted to 2016-2023 EPA methane, with a 90%25 range and the Global Methane Pledge path. Year filter: 2024-2030.</text>"
			    & "</svg>"
		formatString: General
		displayFolder: 6. Report visuals
		lineageTag: 174c7ec1-9ca9-555e-9ac5-bb5e2008fa92
		dataCategory: ImageUrl

	measure 'Card Forecast' =
			VAR y = [Forecast Year]
			VAR cur = CALCULATE([Methane Forecast Mt], REMOVEFILTERS(Dim_Year), Dim_Year[Year] = y)
			VAR prev = CALCULATE([Methane Forecast Mt], REMOVEFILTERS(Dim_Year), Dim_Year[Year] = y - 1)
			VAR dTxt = "90% range " & FORMAT(CALCULATE([Forecast 90% Low Mt], REMOVEFILTERS(Dim_Year), Dim_Year[Year] = y), "0") & " to " & FORMAT(CALCULATE([Forecast 90% High Mt], REMOVEFILTERS(Dim_Year), Dim_Year[Year] = y), "0") & " Mt"
			VAR dCol = "%2326241F"
			VAR vTxt = IF(ISBLANK(cur), "–", FORMAT(cur, "#,##0"))
			VAR vOut = SUBSTITUTE(SUBSTITUTE(vTxt, "%", "%25"), "#", "%23")
			VAR dOut = SUBSTITUTE(SUBSTITUTE(dTxt, "%", "%25"), "#", "%23")
			VAR pts = FILTER(ADDCOLUMNS(FILTER(ALL(Dim_Year[Year]), Dim_Year[Year] >= 2023 && Dim_Year[Year] <= 2030), "@v", [Methane Forecast Mt]), NOT ISBLANK([@v]))
			VAR mx = MAXX(pts, [@v])
			VAR mn = MIN(0, MINX(pts, [@v]))
			VAR poly = CONCATENATEX(pts, FORMAT(ROUND(176 + 104 * (Dim_Year[Year] - 2023) / 7, 0), "0") & "," & FORMAT(ROUND(78 - 34 * DIVIDE([@v] - mn, mx - mn), 0), "0"), " ", Dim_Year[Year], ASC)
			VAR lastYr = MAXX(pts, Dim_Year[Year])
			VAR lastV = MAXX(FILTER(pts, Dim_Year[Year] = lastYr), [@v])
			VAR dot = "<circle cx='" & FORMAT(ROUND(176 + 104 * (lastYr - 2023) / 7, 0), "0") & "' cy='" & FORMAT(ROUND(78 - 34 * DIVIDE(lastV - mn, mx - mn), 0), "0") & "' r='3' fill='%232F6B4F'/>"
			VAR sp = IF(COUNTROWS(pts) > 1, "<polyline points='" & poly & "' fill='none' stroke='%232F6B4F' stroke-width='2' stroke-linejoin='round'/>" & dot)
			RETURN
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='296' height='118' viewBox='0 0 296 118'>"
			    & "<rect x='0.5' y='0.5' width='295' height='117' rx='10' fill='%23FFFDF8' stroke='%23E6DFD1'/>"
			    & "<text x='16' y='27' font-family='Segoe UI, sans-serif' font-size='12' fill='%2326241F'>Methane forecast</text>"
			    & "<text x='16' y='72' font-family='Segoe UI Semibold, Segoe UI, sans-serif' font-size='30' font-weight='600' fill='%231D1C1A'>" & vOut & "<tspan font-size='14' font-weight='normal' fill='%2326241F'> Mt CO2e</tspan></text>"
			    & "<text x='16' y='100' font-family='Segoe UI, sans-serif' font-size='12' fill='" & dCol & "'>" & dOut & "</text>"
			    & sp & "</svg>"
		formatString: General
		displayFolder: 6. Report visuals
		lineageTag: 3a2e1a85-db97-5213-b4c9-8f54de340813
		dataCategory: ImageUrl

	measure 'Card Pledge' =
			VAR y = [Forecast Year]
			VAR cur = CALCULATE([Pledge Path Mt], REMOVEFILTERS(Dim_Year), Dim_Year[Year] = y)
			VAR prev = CALCULATE([Pledge Path Mt], REMOVEFILTERS(Dim_Year), Dim_Year[Year] = y - 1)
			VAR dTxt = "-30% vs 2020 by 2030"
			VAR dCol = "%2326241F"
			VAR vTxt = IF(ISBLANK(cur), "–", FORMAT(cur, "#,##0"))
			VAR vOut = SUBSTITUTE(SUBSTITUTE(vTxt, "%", "%25"), "#", "%23")
			VAR dOut = SUBSTITUTE(SUBSTITUTE(dTxt, "%", "%25"), "#", "%23")
			VAR sp = ""
			RETURN
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='296' height='118' viewBox='0 0 296 118'>"
			    & "<rect x='0.5' y='0.5' width='295' height='117' rx='10' fill='%23FFFDF8' stroke='%23E6DFD1'/>"
			    & "<text x='16' y='27' font-family='Segoe UI, sans-serif' font-size='12' fill='%2326241F'>Global Methane Pledge path</text>"
			    & "<text x='16' y='72' font-family='Segoe UI Semibold, Segoe UI, sans-serif' font-size='30' font-weight='600' fill='%231D1C1A'>" & vOut & "<tspan font-size='14' font-weight='normal' fill='%2326241F'> Mt CO2e</tspan></text>"
			    & "<text x='16' y='100' font-family='Segoe UI, sans-serif' font-size='12' fill='" & dCol & "'>" & dOut & "</text>"
			    & sp & "</svg>"
		formatString: General
		displayFolder: 6. Report visuals
		lineageTag: 1131fda4-ed79-57bc-8c48-4a62dd875d12
		dataCategory: ImageUrl

	measure 'Card PledgeGap' =
			VAR y = [Forecast Year]
			VAR cur = CALCULATE([Forecast Gap to Pledge Mt], REMOVEFILTERS(Dim_Year), Dim_Year[Year] = y)
			VAR prev = CALCULATE([Forecast Gap to Pledge Mt], REMOVEFILTERS(Dim_Year), Dim_Year[Year] = y - 1)
			VAR dTxt = IF(ISBLANK(cur), "", IF(cur <= 0, "Below the pledge path (on track)", "Above the pledge path (off track)"))
			VAR dCol = "%2326241F"
			VAR vTxt = IF(ISBLANK(cur), "–", FORMAT(cur, "+#,##0;-#,##0;0"))
			VAR vOut = SUBSTITUTE(SUBSTITUTE(vTxt, "%", "%25"), "#", "%23")
			VAR dOut = SUBSTITUTE(SUBSTITUTE(dTxt, "%", "%25"), "#", "%23")
			VAR sp = ""
			RETURN
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='296' height='118' viewBox='0 0 296 118'>"
			    & "<rect x='0.5' y='0.5' width='295' height='117' rx='10' fill='%23FFFDF8' stroke='%23E6DFD1'/>"
			    & "<text x='16' y='27' font-family='Segoe UI, sans-serif' font-size='12' fill='%2326241F'>Forecast vs pledge path</text>"
			    & "<text x='16' y='72' font-family='Segoe UI Semibold, Segoe UI, sans-serif' font-size='30' font-weight='600' fill='%231D1C1A'>" & vOut & "<tspan font-size='14' font-weight='normal' fill='%2326241F'> Mt CO2e</tspan></text>"
			    & "<text x='16' y='100' font-family='Segoe UI, sans-serif' font-size='12' fill='" & dCol & "'>" & dOut & "</text>"
			    & sp & "</svg>"
		formatString: General
		displayFolder: 6. Report visuals
		lineageTag: 7ea409ef-3b81-5df0-8518-3e25a6f5ad73
		dataCategory: ImageUrl

	measure 'Card Trend' =
			VAR cur = [Forecast Trend Mt per yr]
			VAR dTxt = "Linear fit to 2016-2023 EPA data"
			VAR dCol = "%2326241F"
			VAR vTxt = IF(ISBLANK(cur), "–", FORMAT(cur, "#,##0.0"))
			VAR vOut = SUBSTITUTE(SUBSTITUTE(vTxt, "%", "%25"), "#", "%23")
			VAR dOut = SUBSTITUTE(SUBSTITUTE(dTxt, "%", "%25"), "#", "%23")
			VAR sp = ""
			RETURN
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='296' height='118' viewBox='0 0 296 118'>"
			    & "<rect x='0.5' y='0.5' width='295' height='117' rx='10' fill='%23FFFDF8' stroke='%23E6DFD1'/>"
			    & "<text x='16' y='27' font-family='Segoe UI, sans-serif' font-size='12' fill='%2326241F'>Trend per year</text>"
			    & "<text x='16' y='72' font-family='Segoe UI Semibold, Segoe UI, sans-serif' font-size='30' font-weight='600' fill='%231D1C1A'>" & vOut & "<tspan font-size='14' font-weight='normal' fill='%2326241F'> Mt CO2e/yr</tspan></text>"
			    & "<text x='16' y='100' font-family='Segoe UI, sans-serif' font-size='12' fill='" & dCol & "'>" & dOut & "</text>"
			    & sp & "</svg>"
		formatString: General
		displayFolder: 6. Report visuals
		lineageTag: 5a5b650f-3fcd-5c76-af33-74d5dd2380dc
		dataCategory: ImageUrl

