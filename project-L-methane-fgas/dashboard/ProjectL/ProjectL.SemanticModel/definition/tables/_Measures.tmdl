		lineageTag: 09deb057-0b0f-5457-9967-dbd0feb4809f

	measure 'O&G Methane MtCO2e' = DIVIDE(CALCULATE(SUM(Fact_SubpartW_Source[CO2e_AR5_tCO2e]), Fact_SubpartW_Source[Gas] = "CH4"), 1e6)
		formatString: #,##0.00
		displayFolder: 2. Oil & gas intensity
		lineageTag: 216f7f88-032e-5be6-8f10-5e81179f75f1

	measure 'Production Methane t' = CALCULATE([O&G Methane t], Fact_SubpartW_Source[Segment] = "Onshore Production")
		formatString: #,##0
