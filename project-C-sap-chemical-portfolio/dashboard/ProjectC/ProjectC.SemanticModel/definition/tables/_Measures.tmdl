		dataCategory: ImageUrl

	measure 'Card Volume' =
			VAR y = [Selected Year]
			VAR lm = [Last Month In Year]
			VAR pl = [Prior Period Label]
			VAR cur = CALCULATE([Volume kt], REMOVEFILTERS(Dim_Date), Dim_Date[Year] = y)
			VAR prev = CALCULATE([Volume kt], REMOVEFILTERS(Dim_Date), Dim_Date[Year] = y - 1, Dim_Date[Month_No] <= lm)
			VAR chg = DIVIDE(cur - prev, prev)
			VAR sub = IF(ISBLANK(prev), FORMAT(y, "0"), IF(chg >= 0, "▲ +", "▼ -") & FORMAT(ABS(chg), "0%") & " vs " & pl)
			VAR clr = IF(chg >= 0, "%230A6ED1", "%23BB0000")
			VAR unit = "kt"
			VAR vTxt = IF(ISBLANK(cur), "–", FORMAT(cur, "#,##0.0"))
			VAR vOut = SUBSTITUTE(SUBSTITUTE(vTxt, "%", "%25"), "#", "%23")
			VAR sOut = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(sub, "&", "&amp;"), "%", "%25"), "#", "%23")
			VAR uOut = SUBSTITUTE(SUBSTITUTE(unit, "%", "%25"), "#", "%23")
			RETURN
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='254' height='110' viewBox='0 0 254 110'>"
			    & "<rect x='0.5' y='0.5' width='253' height='109' rx='4' fill='%23FFFFFF' stroke='%23E5E5E5'/>"
			    & "<text x='16' y='26' font-family=""'72', Segoe UI, Arial, sans-serif"" font-size='14' fill='%2332363A'>Volume sold</text>"
			    & "<text x='16' y='44' font-family=""'72', Segoe UI, Arial, sans-serif"" font-size='11' fill='%236A6D70'>" & sOut & "</text>"
			    & "<text x='16' y='90' font-family=""'72', Segoe UI, Arial, sans-serif"" font-size='32' font-weight='300' fill='" & clr & "'>" & vOut & "<tspan font-size='14' fill='%236A6D70'> " & uOut & "</tspan></text>"
			    & "</svg>"
		formatString: General
		displayFolder: 5. Report visuals
		lineageTag: 881da296-6ad3-547a-ae51-a2b2bfa6beaf
		dataCategory: ImageUrl

	measure 'Card Customers' =
			VAR y = [Selected Year]
			VAR lm = [Last Month In Year]
			VAR pl = [Prior Period Label]
			VAR cur = CALCULATE([Active Customers], REMOVEFILTERS(Dim_Date), Dim_Date[Year] = y)
			VAR prev = CALCULATE([Active Customers], REMOVEFILTERS(Dim_Date), Dim_Date[Year] = y - 1, Dim_Date[Month_No] <= lm)
			VAR chg = cur - prev
			VAR sub = IF(ISBLANK(prev), FORMAT(y, "0"), IF(chg >= 0, "▲ " & FORMAT(chg, "0") & " more than ", "▼ " & FORMAT(ABS(chg), "0") & " fewer than ") & pl)
			VAR clr = IF(chg >= 0, "%230A6ED1", "%23BB0000")
			VAR unit = ""
			VAR vTxt = IF(ISBLANK(cur), "–", FORMAT(cur, "#,##0"))
			VAR vOut = SUBSTITUTE(SUBSTITUTE(vTxt, "%", "%25"), "#", "%23")
			VAR sOut = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(sub, "&", "&amp;"), "%", "%25"), "#", "%23")
			VAR uOut = SUBSTITUTE(SUBSTITUTE(unit, "%", "%25"), "#", "%23")
			RETURN
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='254' height='110' viewBox='0 0 254 110'>"
			    & "<rect x='0.5' y='0.5' width='253' height='109' rx='4' fill='%23FFFFFF' stroke='%23E5E5E5'/>"
			    & "<text x='16' y='26' font-family=""'72', Segoe UI, Arial, sans-serif"" font-size='14' fill='%2332363A'>Active customers</text>"
			    & "<text x='16' y='44' font-family=""'72', Segoe UI, Arial, sans-serif"" font-size='11' fill='%236A6D70'>" & sOut & "</text>"
			    & "<text x='16' y='90' font-family=""'72', Segoe UI, Arial, sans-serif"" font-size='32' font-weight='300' fill='" & clr & "'>" & vOut & "<tspan font-size='14' fill='%236A6D70'> " & uOut & "</tspan></text>"
			    & "</svg>"
		formatString: General
		displayFolder: 5. Report visuals
		lineageTag: abbd626c-a92c-5ee7-98a5-e6aa64a012be
		dataCategory: ImageUrl

