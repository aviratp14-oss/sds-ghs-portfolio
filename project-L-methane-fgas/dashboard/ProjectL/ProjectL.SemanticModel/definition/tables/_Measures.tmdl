			VAR dot = "<circle cx='" & FORMAT(ROUND(176 + 104 * (lastYr - 2016) / 9, 0), "0") & "' cy='" & FORMAT(ROUND(78 - 34 * DIVIDE(lastV - mn, mx - mn), 0), "0") & "' r='3' fill='%232F6B4F'/>"
			VAR sp = IF(COUNTROWS(pts) > 1, "<polyline points='" & poly & "' fill='none' stroke='%232F6B4F' stroke-width='2' stroke-linejoin='round'/>" & dot)
			RETURN
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='296' height='118' viewBox='0 0 296 118'>"
			    & "<rect x='0.5' y='0.5' width='295' height='117' rx='10' fill='%23FFFDF8' stroke='%23E6DFD1'/>"
			    & "<text x='16' y='27' font-family='Segoe UI, sans-serif' font-size='12' fill='%2326241F'>US LNG shipped to the EU</text>"
			    & "<text x='16' y='72' font-family='Segoe UI Semibold, Segoe UI, sans-serif' font-size='30' font-weight='600' fill='%231D1C1A'>" & vOut & "<tspan font-size='14' font-weight='normal' fill='%2326241F'> bcm</tspan></text>"
			    & "<text x='16' y='100' font-family='Segoe UI, sans-serif' font-size='12' fill='" & dCol & "'>" & dOut & "</text>"
			    & sp & "</svg>"
		formatString: General
		displayFolder: 6. Report visuals
		lineageTag: 080a0676-df58-5873-8f4f-752fcfeb3d37
		dataCategory: ImageUrl

	measure 'Card EUShare' =
			VAR y = [Trade Year]
			VAR cur = CALCULATE([EU Share of US LNG %], REMOVEFILTERS(Dim_Year), Dim_Year[Year] = y)
			VAR prev = CALCULATE([EU Share of US LNG %], REMOVEFILTERS(Dim_Year), Dim_Year[Year] = y - 1)
			VAR chg = (cur - prev) * 100
			VAR dTxt = IF(ISBLANK(prev) || ISBLANK(cur), "", IF(chg >= 0, "▲ +", "▼ -") & FORMAT(ABS(chg), "0.0") & " pts vs " & (y - 1))
			VAR dCol = IF(chg >= 0, "%232F6B4F", "%23B3462E")
			VAR vTxt = IF(ISBLANK(cur), "–", FORMAT(cur, "0.0%"))
			VAR vOut = SUBSTITUTE(SUBSTITUTE(vTxt, "%", "%25"), "#", "%23")
			VAR dOut = SUBSTITUTE(SUBSTITUTE(dTxt, "%", "%25"), "#", "%23")
			VAR pts = FILTER(ADDCOLUMNS(FILTER(ALL(Dim_Year[Year]), Dim_Year[Year] >= 2016 && Dim_Year[Year] <= 2025), "@v", [EU Share of US LNG %]), NOT ISBLANK([@v]))
			VAR mx = MAXX(pts, [@v])
			VAR mn = MIN(0, MINX(pts, [@v]))
			VAR poly = CONCATENATEX(pts, FORMAT(ROUND(176 + 104 * (Dim_Year[Year] - 2016) / 9, 0), "0") & "," & FORMAT(ROUND(78 - 34 * DIVIDE([@v] - mn, mx - mn), 0), "0"), " ", Dim_Year[Year], ASC)
			VAR lastYr = MAXX(pts, Dim_Year[Year])
			VAR lastV = MAXX(FILTER(pts, Dim_Year[Year] = lastYr), [@v])
			VAR dot = "<circle cx='" & FORMAT(ROUND(176 + 104 * (lastYr - 2016) / 9, 0), "0") & "' cy='" & FORMAT(ROUND(78 - 34 * DIVIDE(lastV - mn, mx - mn), 0), "0") & "' r='3' fill='%232F6B4F'/>"
			VAR sp = IF(COUNTROWS(pts) > 1, "<polyline points='" & poly & "' fill='none' stroke='%232F6B4F' stroke-width='2' stroke-linejoin='round'/>" & dot)
			RETURN
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='296' height='118' viewBox='0 0 296 118'>"
			    & "<rect x='0.5' y='0.5' width='295' height='117' rx='10' fill='%23FFFDF8' stroke='%23E6DFD1'/>"
			    & "<text x='16' y='27' font-family='Segoe UI, sans-serif' font-size='12' fill='%2326241F'>EU share of US LNG exports</text>"
			    & "<text x='16' y='72' font-family='Segoe UI Semibold, Segoe UI, sans-serif' font-size='30' font-weight='600' fill='%231D1C1A'>" & vOut & "</text>"
			    & "<text x='16' y='100' font-family='Segoe UI, sans-serif' font-size='12' fill='" & dCol & "'>" & dOut & "</text>"
			    & sp & "</svg>"
		formatString: General
		displayFolder: 6. Report visuals
		lineageTag: 20479c1a-b277-5282-89c5-ea2c6b60866f
		dataCategory: ImageUrl

