table _Measures
	lineageTag: 113f9a5d-b97f-50be-a4d8-53409033e085

	measure 'Revenue USD' = SUM(Fact_Sales[Net_Value_USD])
		formatString: \$#,##0
		displayFolder: 1. Sales
		lineageTag: b484b928-d3ad-5c8c-9f2e-08151820b33b

	measure 'Revenue M' = DIVIDE([Revenue USD], 1e6)
		formatString: \$#,##0.0
		displayFolder: 1. Sales
		lineageTag: dee07b74-5e3c-5ac1-bad7-f3665ecb7844

	measure 'Margin USD' = SUM(Fact_Sales[Margin_USD])
		formatString: \$#,##0
		displayFolder: 1. Sales
		lineageTag: fd168e2e-f24a-56ec-bc51-4e253f0d58cd

	measure 'Gross Margin %' = DIVIDE([Margin USD], [Revenue USD])
		formatString: 0.0%
		displayFolder: 1. Sales
		lineageTag: 5bb57f94-60a8-5092-a0e4-fa35ba381fb2

	measure 'Volume kt' = DIVIDE(SUM(Fact_Sales[Qty_kg]), 1e6)
		formatString: #,##0.0
		displayFolder: 1. Sales
		lineageTag: aca2ffd5-37c8-5dbc-b3cd-9cadcaf6e676

	measure 'Active Customers' = CALCULATE(DISTINCTCOUNT(Fact_Sales[Customer_Id]), Fact_Sales[Is_Return] = FALSE(), Dim_Customer[Customer_Type] = "Regular")
		formatString: #,##0
		displayFolder: 1. Sales
		lineageTag: d599c5bf-dd46-58dc-b066-ff345be70414

	measure 'Selected Year' =
			IF(
			    HASONEVALUE(Dim_Date[Year]),
			    VALUES(Dim_Date[Year]),
			    YEAR(CALCULATE(MAX(Fact_Sales[Order_Date]), REMOVEFILTERS()))
			)
		formatString: 0
		displayFolder: 1. Sales
		lineageTag: a441825e-5136-5b79-9e2f-a9d69c677d4b

	measure 'Last Month In Year' =
			-- last month with sales in the selected year, so a part year is compared with the same months a year earlier
			VAR y = [Selected Year]
			RETURN MONTH(CALCULATE(MAX(Fact_Sales[Order_Date]), REMOVEFILTERS(), Dim_Date[Year] = y))
		formatString: 0
		displayFolder: 1. Sales
		lineageTag: 6e28b450-1e8b-5f0c-b33a-ea46bed9de1f

	measure 'Prior Period Label' =
			VAR y = [Selected Year]
			VAR lm = [Last Month In Year]
			RETURN IF(lm = 12, FORMAT(y - 1, "0"), "Jan-" & FORMAT(DATE(y - 1, lm, 1), "mmm") & " " & FORMAT(y - 1, "0"))
		formatString: General
		displayFolder: 1. Sales
		lineageTag: f427161f-f4c6-51fe-bcd5-ed89dc057921

	measure 'Revenue M (Year)' =
			VAR y = [Selected Year]
			RETURN CALCULATE([Revenue M], REMOVEFILTERS(Dim_Date), Dim_Date[Year] = y)
		formatString: \$#,##0.0
		displayFolder: 1. Sales
		lineageTag: eb4cbb83-c2bf-56f9-8e6a-b4c21b188595

	measure 'DOTP kg' = CALCULATE(SUM(Fact_Sales[Qty_kg]), Fact_Sales[Material_Id] = "30000101")
		formatString: #,##0
		displayFolder: 2. Product mix
		lineageTag: a2013f77-e5e9-5d0f-a609-6f0ccf7c01fe

	measure 'DINP kg' = CALCULATE(SUM(Fact_Sales[Qty_kg]), Fact_Sales[Material_Id] = "30000102")
		formatString: #,##0
		displayFolder: 2. Product mix
		lineageTag: 49a37d71-aa89-5771-9382-c5a7471211c5

	measure 'DOTP Share %' = DIVIDE([DOTP kg], [DOTP kg] + [DINP kg])
		formatString: 0%
		displayFolder: 2. Product mix
		lineageTag: d702fb30-9e44-588b-be05-ba449c74f51e

	measure 'DINP Share %' = DIVIDE([DINP kg], [DOTP kg] + [DINP kg])
		formatString: 0%
		displayFolder: 2. Product mix
		lineageTag: be3a8263-2827-578d-b370-a92a032b755f

	measure 'DOTP Margin per kg' = DIVIDE(CALCULATE(SUM(Fact_Sales[Margin_USD]), Fact_Sales[Material_Id] = "30000101"), [DOTP kg])
		formatString: \$0.00
		displayFolder: 2. Product mix
		lineageTag: 5c160087-e1ba-52a5-8e19-68fd57358e69

	measure 'DINP Margin per kg' = DIVIDE(CALCULATE(SUM(Fact_Sales[Margin_USD]), Fact_Sales[Material_Id] = "30000102"), [DINP kg])
		formatString: \$0.00
		displayFolder: 2. Product mix
		lineageTag: 3b9eb0ee-49d3-5f76-aebe-cdb147a4cdbc

	measure 'Margin Gap per kg' =
			-- DOTP minus DINP margin per kg over all data, so the gap does not move with the filters
			CALCULATE([DOTP Margin per kg] - [DINP Margin per kg], REMOVEFILTERS())
		formatString: \$0.00
		displayFolder: 2. Product mix
		lineageTag: 534aa21a-8bda-5b5a-96e5-58ee5f315133

	measure 'Switched Customers' = CALCULATE(COUNTROWS(Dim_Customer), Dim_Customer[Plasticizer_Profile] = "Switched A to B")
		formatString: #,##0
		displayFolder: 2. Product mix
		lineageTag: 5141b8d9-31c3-5f1a-9830-f2cd33291838

	measure 'Plasticizer Customers' = CALCULATE(COUNTROWS(Dim_Customer), Dim_Customer[Plasticizer_Profile] <> "No plasticizer" && Dim_Customer[Plasticizer_Profile] <> "" && NOT ISBLANK(Dim_Customer[Plasticizer_Profile]))
		formatString: #,##0
		displayFolder: 2. Product mix
		lineageTag: 349ae34b-e82b-5c65-91d8-cbd5b0cd3af9

	measure 'Margin Lost to Switching M' =
			-- DINP bought by customers who switched, times what the same kg would have earned as DOTP
			DIVIDE(CALCULATE([DINP kg], Dim_Customer[Plasticizer_Profile] = "Switched A to B") * [Margin Gap per kg], 1e6)
		formatString: \$#,##0.0
		displayFolder: 2. Product mix
		lineageTag: b771ee59-c407-5e3e-bf5a-27bb3a440133

	measure 'DINP Avg Discount %' = CALCULATE(AVERAGE(Fact_Sales[Discount_Share]), Fact_Sales[Material_Id] = "30000102", Fact_Sales[Is_Return] = FALSE())
		formatString: 0.0%
		displayFolder: 2. Product mix
		lineageTag: cb046bc1-5f7d-5071-924a-045db8436a89

	measure 'Spend on Own Chemicals M' = DIVIDE(SUM(Fact_Make_vs_Buy[Spend_USD]), 1e6)
		formatString: \$#,##0.0
		displayFolder: 3. Internal sourcing
		lineageTag: c8cef619-caf1-5bb5-a0c5-676d3605a1d4

	measure 'Avoidable Cost M' = DIVIDE(SUM(Fact_Make_vs_Buy[Avoidable_Cost_USD]), 1e6)
		formatString: \$#,##0.00
		displayFolder: 3. Internal sourcing
		lineageTag: 2ecfa077-1b02-5680-98e8-f880b07d2519

	measure 'Avoidable Cost M (Year)' =
			VAR y = [Selected Year]
			RETURN CALCULATE([Avoidable Cost M], REMOVEFILTERS(Dim_Date), Dim_Date[Year] = y)
		formatString: \$#,##0.00"M"
		displayFolder: 3. Internal sourcing
		lineageTag: 5f506af9-b48a-5b41-9dc4-512c932e1d79

	measure '2-EH Bought t' = CALCULATE(DIVIDE(SUM(Fact_Make_vs_Buy[Bought_kg]), 1000), REMOVEFILTERS(Map_Make_vs_Buy), Fact_Make_vs_Buy[Bought_Material_Id] = "10000209")
		formatString: #,##0
		displayFolder: 3. Internal sourcing
		lineageTag: 140091e8-ece6-5b91-b1a9-8e88bd29b131

	measure '2-EH Surplus Sold t' = CALCULATE(DIVIDE(SUM(Fact_Make_vs_Buy[Surplus_Sold_Spot_kg]), 1000), REMOVEFILTERS(Map_Make_vs_Buy), Fact_Make_vs_Buy[Bought_Material_Id] = "10000209")
		formatString: #,##0
		displayFolder: 3. Internal sourcing
		lineageTag: b4831a76-041e-55c4-a0cf-31fbf79314ee

	measure 'Duplicate Material Pairs' = CALCULATE(COUNTROWS(Map_Make_vs_Buy), REMOVEFILTERS(Map_Make_vs_Buy))
		formatString: 0
		displayFolder: 3. Internal sourcing
		lineageTag: 4dd02d0a-d78a-5670-b2f8-e5c36c558e05

	measure 'Spot Discount vs List %' =
			-- price the trader paid for our 2-EH vs the list price regular customers were quoted
			VAR TraderPrice = DIVIDE(
			    CALCULATE(SUM(Fact_Sales[Net_Value_USD]), Fact_Sales[Customer_Id] = "1009990", Fact_Sales[Material_Id] = "30000201", Fact_Sales[Is_Return] = FALSE()),
			    CALCULATE(SUM(Fact_Sales[Qty_kg]), Fact_Sales[Customer_Id] = "1009990", Fact_Sales[Material_Id] = "30000201", Fact_Sales[Is_Return] = FALSE()))
			VAR ListPrice = DIVIDE(
			    CALCULATE(SUMX(Fact_Sales, Fact_Sales[Qty_kg] * Fact_Sales[List_Price_USD_per_kg]), Fact_Sales[Customer_Id] <> "1009990", Fact_Sales[Material_Id] = "30000201", Fact_Sales[Is_Return] = FALSE()),
			    CALCULATE(SUM(Fact_Sales[Qty_kg]), Fact_Sales[Customer_Id] <> "1009990", Fact_Sales[Material_Id] = "30000201", Fact_Sales[Is_Return] = FALSE()))
			RETURN IF(NOT ISBLANK(TraderPrice), 1 - DIVIDE(TraderPrice, ListPrice))
		formatString: 0%
		displayFolder: 3. Internal sourcing
		lineageTag: 319aa50c-bf33-553d-ad7d-4bd340dd3747

	measure 'Regular Customers' = COUNTROWS(Fact_Customer_Health)
		formatString: #,##0
		displayFolder: 4. Customer health
		lineageTag: 4c81c5ec-0c91-518d-bf35-d26a49f859c9

	measure 'Healthy Customers' = CALCULATE(COUNTROWS(Fact_Customer_Health), Fact_Customer_Health[Status] = "Active")
		formatString: #,##0
		displayFolder: 4. Customer health
		lineageTag: 95deaa86-9e75-57f3-9f8d-244a95a0fe93

	measure 'At Risk Customers' = CALCULATE(COUNTROWS(Fact_Customer_Health), Fact_Customer_Health[Status] = "At risk")
		formatString: #,##0
		displayFolder: 4. Customer health
		lineageTag: 76bb744d-f137-5ab2-b2b3-7eb50ee664ae

	measure 'Lapsed Customers' = CALCULATE(COUNTROWS(Fact_Customer_Health), Fact_Customer_Health[Status] = "Lapsed")
		formatString: #,##0
		displayFolder: 4. Customer health
		lineageTag: 0b913bee-9043-550a-89ad-8c76072bd196

	measure 'Lapsed Last 12m' = CALCULATE(COUNTROWS(Fact_Customer_Health), Fact_Customer_Health[Lapsed_In_Last_12m] = TRUE())
		formatString: #,##0
		displayFolder: 4. Customer health
		lineageTag: 1d450833-afbc-5b9e-8108-902e68da1692

	measure 'Revenue at Risk M' = DIVIDE(SUM(Fact_Customer_Health[Revenue_at_Risk_USD]), 1e6)
		formatString: \$#,##0.0
		displayFolder: 4. Customer health
		lineageTag: 12b0d3b5-df3d-5eaf-963a-2fbca9ad8d2a

	measure 'Recent Lost Revenue M' = DIVIDE(CALCULATE(SUM(Fact_Customer_Health[Lost_Revenue_USD]), Fact_Customer_Health[Lapsed_In_Last_12m] = TRUE()), 1e6)
		formatString: \$#,##0.0
		displayFolder: 4. Customer health
		lineageTag: e3fdcdd1-05c9-50ff-a657-19d941befbe3

	measure 'At Risk or Lapsed %' = DIVIDE([At Risk Customers] + [Lapsed Customers], [Regular Customers])
		formatString: 0%
		displayFolder: 4. Customer health
		lineageTag: db85b152-db11-528e-9fe8-edc41e4d75b1

