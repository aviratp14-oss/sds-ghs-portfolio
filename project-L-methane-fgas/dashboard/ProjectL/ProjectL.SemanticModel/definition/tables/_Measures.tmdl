	measure 'Methane Change since 2016 %' =
			VAR y = [Selected Year]
			VAR NowValue = CALCULATE([Methane MtCO2e], REMOVEFILTERS(Dim_Year), Dim_Year[Year] = y)
			VAR BaseValue = CALCULATE([Methane MtCO2e], REMOVEFILTERS(Dim_Year), Dim_Year[Year] = 2016)
			RETURN DIVIDE(NowValue - BaseValue, BaseValue)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 1. Emissions
		lineageTag: a01478e1-5809-559c-8c7d-bfe0fe67db66

	measure 'O&G Methane t' = CALCULATE(SUM(Fact_SubpartW_Source[Gas_t]), Fact_SubpartW_Source[Gas] = "CH4")
		formatString: #,##0
