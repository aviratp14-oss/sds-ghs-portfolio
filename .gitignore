# Raw downloads are big and can be re-downloaded (see data/raw/README.md)
**/data/raw/*
!**/data/raw/README.md
# Project C's raw files are small simulated SAP exports, so they stay in the repo
!project-C-sap-chemical-portfolio/data/raw/*.csv
# Project I's raw files are small public-source tables I typed up or downloaded, so they stay too
!project-I-lithium-india/data/raw/*.csv

# Power BI local files
**/.pbi/localSettings.json
**/.pbi/cache.abf
*.pbix.bak

# Python
__pycache__/
*.pyc
.venv/
venv/

# Office and OS clutter
~$*
.DS_Store
Thumbs.db
desktop.ini
*.zip
