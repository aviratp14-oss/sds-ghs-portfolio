table _Measures
	lineageTag: 10a2fc3f-287a-5b45-9a1a-36832c7f0a7d

	measure 'GHG tCO2e' = SUM(Fact_Emissions[CO2e_AR5_tCO2e])
		formatString: #,##0
		displayFolder: 1. Emissions
		lineageTag: bc51d9bf-7e07-5206-9637-4782ebf3b018

	measure 'GHG MtCO2e' = DIVIDE([GHG tCO2e], 1e6)
		formatString: #,##0.0
		displayFolder: 1. Emissions
		lineageTag: 564dc814-9b6f-5c84-8a75-7533d9f843bb

	measure 'Methane MtCO2e' = CALCULATE([GHG MtCO2e], Fact_Emissions[Gas_Group] = "Methane")
		formatString: #,##0.0
		displayFolder: 1. Emissions
		lineageTag: c9ddb045-245d-503d-90a9-c155655ae3db

	measure 'F-gas MtCO2e' = CALCULATE([GHG MtCO2e], Fact_Emissions[Gas_Group] = "F-gases")
		formatString: #,##0.00
